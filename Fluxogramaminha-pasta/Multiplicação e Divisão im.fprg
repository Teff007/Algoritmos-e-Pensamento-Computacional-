<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Multiplica&#231;&#227;o e Divis&#227;o"/>
        <attribute name="authors" value="steff"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-19 09:12:57 "/>
        <attribute name="created" value="c3RlZmY7REVTS1RPUC0wUEE1VTRUOzIwMjYtMDgtMTk7IjA4OjEwOjQ1ICI7Mjc4Nw=="/>
        <attribute name="edited" value="c3RlZmY7REVTS1RPUC0wUEE1VTRUOzIwMjYtMDgtMTk7IjA5OjEyOjU3ICI7MjsyOTAy"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="op&#231;&#227;o" type="Real" array="False" size=""/>
            <output expression="&quot;Digite a sua op&#231;&#227;o&quot;" newline="True"/>
            <input variable="op&#231;&#227;o"/>
            <if expression="op&#231;&#227;o=03">
                <then>
                    <declare name="a, b, multiplica&#231;&#227;o" type="Real" array="False" size=""/>
                    <output expression="&quot;Digite o numero de a&quot;" newline="True"/>
                    <input variable="a"/>
                    <output expression="&quot;Digite o numero de b&quot;" newline="True"/>
                    <input variable="b"/>
                    <assign variable="multiplica&#231;&#227;o" expression="a*b"/>
                    <output expression="&quot;A multiplica&#231;&#227;o e igual a: &quot;&amp;multiplica&#231;&#227;o&amp;&quot;&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="op&#231;&#227;o=04">
                        <then>
                            <declare name="a, b, divis&#227;o" type="Real" array="False" size=""/>
                            <output expression="&quot;Digite o n&#250;mero de a &quot;" newline="True"/>
                            <input variable="a"/>
                            <output expression="&quot;Digite o n&#250;mero de b&quot;" newline="True"/>
                            <input variable="b"/>
                            <assign variable="divis&#227;o" expression="a/b"/>
                            <output expression="&quot; A divis&#227;o e igual a:&quot;&amp;divis&#227;o&amp;&quot;&quot;" newline="True"/>
                        </then>
                        <else/>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
