<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="seno-cosseno"/>
        <attribute name="authors" value="silvi"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-24 07:26:35 "/>
        <attribute name="created" value="c2lsdmk7U0lMVklBOzIwMjYtMDgtMjE7IjA4OjIyOjIzICI7MjIwMA=="/>
        <attribute name="edited" value="c2lsdmk7U0lMVklBOzIwMjYtMDgtMjQ7IjA3OjI2OjM1ICI7MzsyMzE5"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="contador" type="Integer" array="False" size=""/>
            <declare name="seno" type="Real" array="False" size=""/>
            <declare name="cosseno" type="Real" array="False" size=""/>
            <assign variable="contador" expression="1"/>
            <while expression="contador&lt;&gt;11">
                <assign variable="seno" expression="Sin(contador * 3.14159/180)"/>
                <assign variable="cosseno" expression="Cos(contador * 3.14159/180)"/>
                <output expression="contador &amp; &quot; -&gt; Seno: &quot; &amp; seno &amp; &quot; Cosseno: &quot; &amp; cosseno" newline="True"/>
                <assign variable="contador" expression="contador + 1"/>
            </while>
        </body>
    </function>
</flowgorithm>
