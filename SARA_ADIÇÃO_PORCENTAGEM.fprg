<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="algoritmo"/>
        <attribute name="authors" value="Casa"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-24 08:40:39 "/>
        <attribute name="created" value="Q2FzYTtERVNLVE9QLTROUU43NVU7MjAyNi0wOC0xOTsiMDg6NTY6NTMgIjsyNjUx"/>
        <attribute name="edited" value="Q2FzYTtERVNLVE9QLTROUU43NVU7MjAyNi0wOC0yNDsiMDg6NDA6MzkgIjsyOzI3NTM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="op&#231;ao" type="Integer" array="False" size=""/>
            <declare name="num1, num2, resultado" type="Real" array="False" size=""/>
            <output expression="&quot;Digite qual op&#231;&#227;o vai ser utilizada: 1- adi&#231;&#227;o;2-Subtra&#231;&#227;o;3-Multiplica&#231;&#227;o; 4- Divis&#227;o; 5- Potencia&#231;&#227;o; 6- Raiz quadrada; 7- Porcentagem; 8- M&#243;dulo; 9- Seno; 10- Cosseno; 0 -Sair&quot;" newline="True"/>
            <input variable="op&#231;ao"/>
            <if expression="op&#231;ao=1">
                <then>
                    <output expression="&quot;Digite o primeiro n&#250;mero:&quot;" newline="True"/>
                    <input variable="num1"/>
                    <output expression="&quot;Digite o segundo n&#250;mero:&quot;" newline="True"/>
                    <input variable="num2"/>
                    <assign variable="resultado" expression="num1+num2"/>
                    <output expression="&quot;O resultado da soma foi:&quot;&amp;resultado" newline="True"/>
                </then>
                <else/>
            </if>
            <if expression="op&#231;ao=7">
                <then>
                    <output expression="&quot;Voc&#234; deseja: 1- Acrescentar ou 2- Diminuir? &quot;" newline="True"/>
                    <input variable="op&#231;ao"/>
                    <if expression="op&#231;ao=1">
                        <then>
                            <output expression="&quot;Digite o valor:&quot;" newline="True"/>
                            <input variable="num1"/>
                            <output expression="&quot;Digite a porcentagem:&quot;" newline="True"/>
                            <input variable="num2"/>
                            <assign variable="resultado" expression="num1*(1+num2/100)"/>
                            <output expression="&quot;O resultado &#233;:&quot;&amp;resultado" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Digite o valor:&quot;" newline="True"/>
                            <input variable="num1"/>
                            <output expression="&quot;Digite a porcentagem:&quot;" newline="True"/>
                            <input variable="num2"/>
                            <assign variable="resultado" expression="num1*(1-num2/100)"/>
                            <output expression="&quot;O resultado final &#233;:&quot;&amp;resultado" newline="True"/>
                        </else>
                    </if>
                </then>
                <else/>
            </if>
        </body>
    </function>
</flowgorithm>
